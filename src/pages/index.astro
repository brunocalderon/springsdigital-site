---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main>
		<p class="brand">Springs Digital</p>
		<h1>Coming soon</h1>
	</main>
</Layout>

<style>
	main {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		min-height: 100dvh;
		padding: 1.5rem;
		box-sizing: border-box;
		text-align: center;
	}

	.brand {
		margin: 0;
		font-size: clamp(0.875rem, 2.5vw, 1rem);
		font-weight: 500;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: #a3a3a3;
	}

	h1 {
		margin: 0;
		font-size: clamp(1.75rem, 5vw, 2.5rem);
		font-weight: 400;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #f5f5f5;
	}
</style>
